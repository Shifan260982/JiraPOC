{
  "name": "jira-reporting-assistant-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build && vite build -c vite.overlay.config.ts",
    "dev": "vite build -c vite.overlay.config.ts && vite build --watch --mode development",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "fixture": "vite-node scripts/make-scan-fixture.ts",
    "preview:ui": "vite --config dev/vite.config.ts"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/chrome": "^0.1.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.9.0",
    "vite": "^6.4.0",
    "vitest": "^3.2.0"
  }
}
