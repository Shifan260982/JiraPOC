{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "backend/.venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "app.main:app",
        "--app-dir",
        "backend",
        "--host",
        "127.0.0.1",
        "--port",
        "8001"
      ],
      "port": 8001
    },
    {
      "name": "mock-tool",
      "runtimeExecutable": "backend/.venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m",
        "http.server",
        "5500",
        "--bind",
        "127.0.0.1",
        "--directory",
        "samples/mock-tool"
      ],
      "port": 5500
    },
    {
      "name": "ui-preview",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "--prefix",
        "extension",
        "vite",
        "--config",
        "extension/dev/vite.config.ts"
      ],
      "port": 5174
    }
  ]
}
